# AI providers — set BOTH for the fallback chain. They are tried cheapest first:
# Gemini serves the request; Anthropic only picks up what the free tier refused
# (out of capacity, or past its 20-generations-per-day cap).
# 1. Google Gemini (free tier, no card) — key from https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# 2. Direct Anthropic API — paid safety net. Key from https://console.anthropic.com
#    Without it there is no fallback: a free-tier outage is a failed request.
ANTHROPIC_API_KEY=
# Optional model overrides for the two above (defaults: gemini-3.6-flash, claude-sonnet-5)
GOOGLE_MODEL=
ANTHROPIC_MODEL=
# 3. Vercel AI Gateway (needs credits) — used only when neither key above is set
AI_GATEWAY_API_KEY=

# eBay developer app credentials — https://developer.ebay.com/my/keys
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# The RuName from your eBay app's "User Tokens" page. Its "auth accepted URL"
# must point to https://<your-deployment>/api/ebay/callback
EBAY_RU_NAME=
# "sandbox" (default) or "production"
EBAY_ENV=sandbox
EBAY_MARKETPLACE_ID=EBAY_GB

# Vercel Blob — automatic on Vercel once a Blob store is attached
BLOB_READ_WRITE_TOKEN=

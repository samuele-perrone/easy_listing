# AI provider — one key, free tier. Key from https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# Free Gemini models to try in order. The daily cap is 20 requests PER MODEL, so
# each id listed adds 20 more free generations a day, and a model that's out of
# capacity falls through to the next. Best first: quality degrades only when the
# better models are spent. These three are confirmed working (25 Sep 2026):
GOOGLE_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite
# Optional: a paid safety net for when every free model refuses. Deliberately
# UNSET — this deployment is free-only by choice. Setting it starts billing.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Vercel AI Gateway (needs credits) — used only when no direct key is set at all
AI_GATEWAY_API_KEY=

# eBay developer app credentials — https://developer.ebay.com/my/keys
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# The RuName from your eBay app's "User Tokens" page. Its "auth accepted URL"
# must point to https://<your-deployment>/api/ebay/callback
EBAY_RU_NAME=
# "sandbox" (default) or "production"
EBAY_ENV=sandbox
EBAY_MARKETPLACE_ID=EBAY_GB

# Vercel Blob — automatic on Vercel once a Blob store is attached
BLOB_READ_WRITE_TOKEN=

# --- Sign-in, and who may post to eBay ---------------------------------------
# Signs the app's own session after Apple or Google has been verified.
# At least 32 characters: `openssl rand -base64 48`. Rotating it signs everyone
# out, which is the intended way to revoke every session at once.
AUTH_JWT_SECRET=

# Emails allowed to post to eBay. Comma-, space- or newline-separated.
# An UNSET or empty value permits NOBODY — a missed variable must not mean
# "everyone", or a typo turns the endpoint open. Add a tester by appending
# their address and redeploying.
EBAY_POST_ALLOWED_EMAILS=

# Escape hatch for builds that predate sign-in: "false" lets a request with no
# Authorization header through (a signed-in caller is still allow-listed).
# Defaults to requiring auth. Remove it once every install has the new build.
EBAY_POST_REQUIRE_AUTH=

# Google OAuth client (Google Cloud console → APIs & Services → Credentials).
# Create a **Web application** client, not an iOS one: the app uses the backend's
# web flow, so Google must accept this redirect URI exactly —
#   https://easy-listing-chi.vercel.app/api/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Override only for a preview deployment on a different hostname.
GOOGLE_OAUTH_REDIRECT_URI=

# Audience for verifying Apple identity tokens: the app's bundle id for a
# native Sign in with Apple. Defaults to com.samperrone.easylisting.
APPLE_CLIENT_ID=

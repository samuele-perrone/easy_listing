# AI provider — set ONE of these; picked in this order:
# 1. Direct Anthropic API (best quality) — key from https://console.anthropic.com
ANTHROPIC_API_KEY=
# 2. Google Gemini (free tier, no card) — key from https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# 3. Vercel AI Gateway (needs credits) — automatic on Vercel, or AI_GATEWAY_API_KEY locally
AI_GATEWAY_API_KEY=

# eBay developer app credentials — https://developer.ebay.com/my/keys
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# The RuName from your eBay app's "User Tokens" page. Its "auth accepted URL"
# must point to https://<your-deployment>/api/ebay/callback
EBAY_RU_NAME=
# "sandbox" (default) or "production"
EBAY_ENV=sandbox
EBAY_MARKETPLACE_ID=EBAY_GB

# Vercel Blob — automatic on Vercel once a Blob store is attached
BLOB_READ_WRITE_TOKEN=

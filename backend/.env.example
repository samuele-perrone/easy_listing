# AI provider — one key, free tier. Key from https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# Free Gemini models to try in order. The daily cap is 20 requests PER MODEL, so
# each id listed adds 20 more free generations a day, and a model that's out of
# capacity falls through to the next. Best first: quality degrades only when the
# better models are spent. These three are confirmed working (25 Sep 2026):
GOOGLE_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite
# Optional: a paid safety net for when every free model refuses. Deliberately
# UNSET — this deployment is free-only by choice. Setting it starts billing.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Vercel AI Gateway (needs credits) — used only when no direct key is set at all
AI_GATEWAY_API_KEY=

# eBay developer app credentials — https://developer.ebay.com/my/keys
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# The RuName from your eBay app's "User Tokens" page. Its "auth accepted URL"
# must point to https://<your-deployment>/api/ebay/callback
EBAY_RU_NAME=
# "sandbox" (default) or "production"
EBAY_ENV=sandbox
EBAY_MARKETPLACE_ID=EBAY_GB

# Vercel Blob — automatic on Vercel once a Blob store is attached
BLOB_READ_WRITE_TOKEN=

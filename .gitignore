.DS_Store
# EasyListing.xcodeproj is generated by XcodeGen but committed anyway:
# Xcode Cloud validates the workflow's project reference before it runs
# ci_post_clone.sh, so a repo without it can't start a build.
**/xcuserdata/
ios/build/
ios/DerivedData/
.vercel
.env*

# Intermediates from the app-icon pipeline (see docs/STATUS.md); icon.svg is the source
ios/icon.png
ios/icon.jpg
ios/icon.svg.png
